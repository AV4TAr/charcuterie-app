# Copy this file to .env.local and fill in your Supabase project credentials.
# Create a project at https://supabase.com and find the values under Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Secret used to encrypt per-user Anthropic API keys (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If you lose this value, all saved user keys become unrecoverable.
API_KEY_ENCRYPTION_SECRET=base64-of-32-random-bytes

# (Optional, dev-only fallback) Used by Don Marco when the user has no personal key.
# Ignored in production — production users must add their own key in /settings.
ANTHROPIC_API_KEY=sk-ant-...
